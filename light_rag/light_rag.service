[Unit]
Description=RAG Knowledge Base MCP Server (Light RAG)
After=network.target
Requires=network-online.target
Documentation=man:uv(1)

[Service]
# 基础配置
User=root
WorkingDirectory=/opt/mcp-servers/servers/light_rag

# 关闭命名空间隔离（解决 226/NAMESPACE 错误）
PrivateTmp=false
ProtectSystem=false
ProtectHome=false
ProtectKernelTunables=false
ProtectControlGroups=false
NoNewPrivileges=false

# 环境变量
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/mcp-servers/servers/light_rag/src
Environment=UV_REGISTRY_INDEX=https://mirrors.aliyun.com/pypi/simple/
Environment=UV_REGISTRY_TRUSTED_HOSTS=mirrors.aliyun.com
Environment=UV_REGISTRY_TIMEOUT=180
Environment=PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
Environment=PIP_TRUSTED_HOST=mirrors.aliyun.com
Environment=PIP_DEFAULT_TIMEOUT=180

# uv 依赖安装（uv sync，失败兜底：不影响服务启动）
ExecStartPre=/usr/bin/bash -c "timeout 600 /usr/local/bin/uv sync --project /opt/mcp-servers/servers/light_rag/src --cache-dir /opt/mcp-servers/servers/light_rag/.uv_cache || echo 'UV sync failed, use existing venv' && exit 0"

# 主执行：uv run 启动服务
ExecStart=uv run --project /opt/mcp-servers/servers/light_rag/src /opt/mcp-servers/servers/light_rag/src/server.py

# 启动策略
Restart=always
RestartSec=5
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=30
SuccessExitStatus=143

# 日志输出
StandardOutput=journal+console
StandardError=journal+console
SyslogIdentifier=light-rag

[Install]
WantedBy=multi-user.target
