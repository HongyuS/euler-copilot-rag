[Unit]
Description=Log Detection Service From Witty
After=network.target
Requires=network-online.target
Documentation=man:uv(1)

[Service]
# 基础配置
User=root
WorkingDirectory=/opt/mcp-servers/servers/witty_log_detection

# 关闭命名空间隔离（解决226/NAMESPACE错误）
PrivateTmp=false
ProtectSystem=false
ProtectHome=false
ProtectKernelTunables=false
ProtectControlGroups=false
NoNewPrivileges=false

# 环境变量（适配旧版uv）
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/mcp-servers/servers/witty_log_detection
Environment=UV_PROJECT_ENV=/opt/mcp-servers/servers/witty_log_detection/.venv
Environment=UV_REGISTRY_INDEX=https://mirrors.aliyun.com/pypi/simple/
Environment=UV_REGISTRY_TRUSTED_HOSTS=mirrors.aliyun.com
Environment=UV_REGISTRY_TIMEOUT=180
Environment=PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
Environment=PIP_TRUSTED_HOST=mirrors.aliyun.com
Environment=PIP_DEFAULT_TIMEOUT=180

# ========== 核心修复：移除旧版uv不支持的--reuse-existing参数 ==========
# 失败兜底：即使uv sync失败，也返回0（不影响服务启动）
ExecStartPre=/usr/bin/bash -c "timeout 600 /usr/local/bin/uv sync \
  --cache-dir /opt/mcp-servers/servers/witty_log_detection/.uv_cache \
  --project /opt/mcp-servers/servers/witty_log_detection/src || echo 'UV sync failed, use existing venv' && exit 0"

# 主执行：启动服务
ExecStart=uv run --project /opt/mcp-servers/servers/witty_log_detection/src /opt/mcp-servers/servers/witty_log_detection/src/server.py

# 启动策略（避免无限重启）
Restart=on-failure
RestartSec=120
TimeoutStartSec=900
TimeoutSec=1200
TimeoutStopSec=60
KillMode=control-group
KillSignal=SIGTERM
SuccessExitStatus=143

# 资源限制
LimitNOFILE=102400
LimitNPROC=16384
LimitAS=infinity
LimitCORE=infinity

# 日志输出（便于排查）
StandardOutput=journal+console
StandardError=journal+console
SyslogIdentifier=witty-log-detection

[Install]
WantedBy=multi-user.target